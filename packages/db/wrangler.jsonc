{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "db",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "minify": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DB",
      "database_id": "DB",
      "migrations_dir": "drizzle"
    }
  ]
}
